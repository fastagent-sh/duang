{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "electron"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "electron.vite.config.ts"]
}
