    "@shikijs/themes": "^4.4.3",
    "react-shiki": "^0.11.1",
    "streamdown": "^2.6.0",
    "undici": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.1",
    "electron-vite": "^5.0.0",
