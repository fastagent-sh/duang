{
  "name": "duang",
  "version": "0.0.0",
  "description": "A native workbench for FastAgent agents.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev --watch",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:smoke": "npm run build && node tests/smoke.mjs && node tests/transcript.mjs",
    "test:live": "npm run build && node tests/live.mjs",
    "shots": "npm run build && node tests/shot.mjs",
    "package": "npm run build && electron-builder --mac",
    "test:package": "npm run package && node tests/packaged.mjs",
    "test:perf": "npm run build && node tests/perf.mjs"
  },
  "dependencies": {
    "@fastagent-sh/fastagent": "0.24.4",
    "hono": "4.13.12",
    "undici": "^7.18.1"
  },
  "devDependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@electron/asar": "4.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-shiki": "^0.11.1",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "protobufjs": false,
    "@google/genai": false,
    "fsevents": false
  }
}
